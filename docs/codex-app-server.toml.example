# Documentation only. Do not enable until complete tool denial is proven against
# a pinned binary/protocol. The working prototype uses direct Responses.
# Supply the token ONLY to the isolated child process environment.
model_provider = "roofready_chatgpt_plan"
[model_providers.roofready_chatgpt_plan]
name = "RoofReady ChatGPT plan"
base_url = "https://api.openai.com/v1"
env_key = "ROOFREADY_AI_ACCESS_TOKEN"
wire_api = "responses"
requires_openai_auth = false
supports_websockets = false
